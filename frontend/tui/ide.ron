(
    mode: Tui,
    keybindings: {
        "ctrl+h": "focus_hierarchy",
        "ctrl+v": "focus_viewport",
        "ctrl+i": "focus_inspector",
        "ctrl+f": "focus_project",
        "ctrl+t": "focus_terminal",
        "m": "toggle_viewport_mode",
        "r": "toggle_run",
        "q": "quit",
    },
    // Mixed (dim=braille dots, bright=quadrant blocks), Quadrant (2x2 blocks),
    // Braille (2x4 dots), or Image (ratatui-image)
    viewport_mode: Mixed,
)
