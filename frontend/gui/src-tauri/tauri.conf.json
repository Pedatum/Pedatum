{
  "$schema": "https://raw.githubusercontent.com/nicholastmosher/tauri/feat-schema/tooling/cli/schema.json",
  "productName": "Shinra Engine IDE",
  "version": "0.1.0",
  "identifier": "com.shinra.engine.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Shinra Engine IDE",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
